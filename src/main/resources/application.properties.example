spring.application.name=banking

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/intelligent_banking_db}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# JWT Configuration
app.jwtSecret=${JWT_SECRET:mySecretKeyForBankingApplicationThatIsAtLeast256BitsLongForHS256Algorithm}
app.jwtAccessTokenExpiration=${JWT_ACCESS_EXPIRATION:900000}
app.jwtRefreshTokenExpiration=${JWT_REFRESH_EXPIRATION:604800000}

# Server Configuration
server.port=8080
server.servlet.context-path=/

# Logging
logging.level.root=INFO
logging.level.com.banking=DEBUG
logging.level.org.springframework.security=DEBUG

# API Documentation
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha
